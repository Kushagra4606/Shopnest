# Server Configuration
# IMPORTANT: In production this MUST be set (the server refuses to start without it).
SECRET_KEY=your_secret_key_here

# Comma-separated list of allowed browser origins for API requests.
# Leave unset in development (CORS is open). Set it in production, e.g.:
# CORS_ORIGIN=https://your-shop.vercel.app
CORS_ORIGIN=https://your-shop.vercel.app

# Cloudinary Configuration
# Get these from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Note: When deploying to Vercel, add these as Environment Variables in:
# Vercel Dashboard → Your Project → Settings → Environment Variables
